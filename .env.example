# Project root .env.example
# Copy this file to .env and fill in real values before running scripts.

############################################################
# hushsense-smart-contract
# (deployment & contract interactions)
############################################################
# Hedera operator account
MY_ACCOUNT_ID=0.0.xxxxxx
# Private key in DER format (used by some scripts)
MY_PRIVATE_KEY_DER=302e02... (DER-format private key)
# Alternative private key (hex/other) - some scripts use MY_PRIVATE_KEY
MY_PRIVATE_KEY=302e02... (or ED25519 hex)
# Network: testnet | mainnet
HEDERA_NETWORK=testnet
# (Written by deploy script) Contract ID and EVM address created after deployment
HUSHSENSE_MANAGER_CONTRACT_ID=0.0.xxxxxx
HUSHSENSE_MANAGER_EVM_ADDRESS=0x...
# Token solidity address (used when initializing contract)
TOKEN_SOLIDITY_ADDRESS=0x...

############################################################
# hushsense-token-nft
# (HTS token & NFT management scripts)
############################################################
# Use same operator creds as above or set per-folder values
MY_ACCOUNT_ID=0.0.xxxxxx
MY_PRIVATE_KEY=302e02...
# When creating token: optional metadata CID (IPFS)
TOKEN_METADATA_CID=Qm...
# NFT collection ID (set after nftCreate.js runs)
HUSHSENSE_NFT_ID=0.0.xxxxxx
# Metadata CID used when minting NFTs
NFT_METADATA_CID=Qm...
# Contract manager ID used when creating token supply/pause keys
HUSHSENSE_MANAGER_CONTRACT_ID=0.0.xxxxxx

############################################################
# Scripts & utilities (minting/test scripts)
############################################################
# Contract address (Hedera format 0.0.x) used by some helper scripts
HUSHSENSE_CONTRACT_ADDRESS=0.0.xxxxxx
# Recipient / user wallet (EVM or Hedera format)
USER_WALLET=0x... or 0.0.xxxxxx
# Amounts for test mints
MINT_AMOUNT=100

############################################################
# mobile (Flutter)
# Mobile app uses Firebase and runtime configuration rather than a single .env
# Placeholders / instructions below — mobile may expect platform config files
############################################################
# Firebase Android/iOS config files are required (google-services.json / GoogleService-Info.plist)
# If using runtime environment variables in the mobile app, set these values in your CI or manual config
BASE_API_URL=https://api.hushsense.com
HEDERA_NETWORK_URL=https://testnet.hashscan.io
ENABLE_HEDERA_INTEGRATION=false

# NOTES:
# - Some scripts expect MY_PRIVATE_KEY_DER (DER-encoded key) while others use MY_PRIVATE_KEY.
#   Keep both present if you are unsure which script will be run.
# - Do NOT commit actual private keys to source control. Use secrets manager or CI variables for production.
